# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/

# Per-book working + output directories (created at runtime beside the source PDF),
# and the local run directories themselves — translated books are never committed.
work/
output/
runs/

# Large downloaded datasets (~210MB, re-created by scripts/setup_data.py).
# data/* (not data/) so the negations below can re-include curated source files.
data/*
# ...but the curated master glossary IS source, not a download — keep it tracked.
!data/glossary.json
!data/glossary-seed-notes.md
!data/glossary-changelog.md
!data/glossary-conflicts.md
!data/series/
# ...as are the sign-off-gated dataset-English corrections, the download manifest,
# and the surah-names snapshot (its source API is unpinnable, so the file is source).
!data/english-fixes.json
!data/MANIFEST.json
!data/surah_names.json

# Editor's auto-loaded local copies (derived from runs/ + data/)
editor/*.en.srt
editor/bilingual.md
